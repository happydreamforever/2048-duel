# Copy this file to server.env (git-ignored) and edit. Environment variables override it.
PORT=8080

# ---- MySQL, option A: JDBC URL plus separate credentials (defaults)
DB_URL=jdbc:mysql://127.0.0.1:3306/duel2048
DB_USER=duel2048
DB_PASSWORD=duel2048

# ---- MySQL, option B: one cloud-style URI with the credentials inside (Aiven, PlanetScale, ...)
# DB_URL=mysql://user:password@host:port/dbname?ssl-mode=REQUIRED

# ---- MariaDB, option A: JDBC URL (MariaDB driver) plus separate credentials
# DB_URL=jdbc:mariadb://127.0.0.1:3306/duel2048
# DB_USER=duel2048
# DB_PASSWORD=duel2048

# ---- MariaDB, option B: URI with credentials inside; ssl-mode=REQUIRED becomes the driver's sslMode=trust
# DB_URL=mariadb://user:password@host:3306/dbname?ssl-mode=REQUIRED

# ---- Development without a database server: keep users in data/duel2048-db.json
# DB=json

# ---- Gameplay tuning (optional)
# BOT_FALLBACK_MS=8000
# MATCH_DURATION_MS=150000
