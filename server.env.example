# Copy this file to server.env (git-ignored) and edit. Environment variables override it.
PORT=8080

# ---- Database
# Preferred: put the connection settings in database.json (copy database.json.example). When that
# file exists it is used and the DB_* values below are ignored.
#
# Same settings as individual keys (for Docker / CI):
# DB_TYPE=mariadb            # mariadb or mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=duel2048
# DB_CHARSET=utf8mb4
# DB_SSL=false
#
# Cloud MySQL URI with the credentials inside (Aiven, PlanetScale, ...):
# DB_URL=mysql://user:password@host:port/dbname?ssl-mode=REQUIRED
#
# Development without a database server: keep users in data/duel2048-db.json
# DB=json

# ---- Gameplay tuning (optional)
# BOT_FALLBACK_MS=8000
# MATCH_DURATION_MS=150000
